local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.GameConfig)
local Data=require(script.Parent.Services.PlayerDataService)
local Mining=require(script.Parent.Services.MiningService)
local Upgrades=require(script.Parent.Services.UpgradeService)
local Pets=require(script.Parent.Services.PetService)
local Eggs=require(script.Parent.Services.EggService)
local Combat=require(script.Parent.Services.CombatService)
local EggSpawner=require(script.Parent.Services.EggSpawner)
local MapBuilder=require(script.Parent.Services.MapBuilder)
local Admin=require(script.Parent.Services.AdminService)
local map=MapBuilder.Build()
local remotes=ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder"); remotes.Name="Remotes"; remotes.Parent=ReplicatedStorage
local function remote(n) local r=remotes:FindFirstChild(n) or Instance.new("RemoteEvent"); r.Name=n; r.Parent=remotes; return r end
local Mine=remote("MineResource"); local Sell=remote("Sell"); local Upgrade=remote("UpgradePickaxe"); local Armor=remote("UpgradeArmor"); local HitPlayer=remote("HitPlayer"); local TakeEgg=remote("TakeEgg"); local Hatch=remote("HatchCarriedEgg"); local State=remote("StateUpdate"); local Notice=remote("Notification"); local RequestState=remote("RequestState"); local AdminAction=remote("AdminAction"); local AdminNotice=remote("AdminNotice")
local resources=workspace:FindFirstChild("MiningResources") or Instance.new("Folder"); resources.Name="MiningResources"; resources.Parent=workspace
local function node(name,pos,color,material) local p=Instance.new("Part"); p.Name=name; p.Shape=Enum.PartType.Ball; p.Size=Vector3.new(7,6,7); p.Position=pos; p.Anchored=true; p.Color=color; p.Material=material or Enum.Material.Slate; p.Parent=resources; p:SetAttribute("Health",Config.Resources[name].MaxHealth) end
if #resources:GetChildren()==0 then node("Stone",Vector3.new(-18,4,72),Color3.fromRGB(100,100,100)); node("Stone",Vector3.new(0,4,76),Color3.fromRGB(110,110,110)); node("Crystal",Vector3.new(18,5,72),Color3.fromRGB(80,180,255),Enum.Material.Neon); node("DesertRock",Vector3.new(-18,4,162),Color3.fromRGB(170,130,75)); node("DesertRock",Vector3.new(18,4,170),Color3.fromRGB(190,145,80)); node("IceCrystal",Vector3.new(-16,5,252),Color3.fromRGB(160,230,255),Enum.Material.Ice); node("IceCrystal",Vector3.new(18,5,260),Color3.fromRGB(130,210,255),Enum.Material.Ice); node("MagmaRock",Vector3.new(-18,5,342),Color3.fromRGB(70,45,40)); node("MagmaRock",Vector3.new(18,5,350),Color3.fromRGB(80,50,40)) end
local sell=workspace:FindFirstChild("SellArea") or map:FindFirstChild("SellArea")
local hatchPad=workspace:FindFirstChild("HatchPad") or Instance.new("Part"); hatchPad.Name="HatchPad"; hatchPad.Size=Vector3.new(14,1,14); hatchPad.Position=Vector3.new(25,2,-10); hatchPad.Anchored=true; hatchPad.Material=Enum.Material.Neon; hatchPad.Color=Color3.fromRGB(160,90,255); hatchPad.Parent=workspace
local function sync(p) local d=Data.Get(p); if not d then return end; p:SetAttribute("Armor",d.Armor or "Cloth"); State:FireClient(p,{Coins=d.Coins,BackpackAmount=d.BackpackAmount,BackpackCapacity=d.BackpackCapacity,Pickaxe=d.Pickaxe,Armor=d.Armor,PetMultiplier=Pets.GetMultiplier(p),PetCount=#d.Pets,Carrying=Eggs.IsCarrying(p),EquippedPets=d.EquippedPets}) end
local function syncAll() for _,p in ipairs(Players:GetPlayers()) do sync(p) end end
local function leader(p) local f=Instance.new("Folder"); f.Name="leaderstats"; f.Parent=p; local c=Instance.new("IntValue"); c.Name="Coins"; c.Parent=f; task.spawn(function() while p.Parent do local d=Data.Get(p); if d then c.Value=d.Coins end task.wait(1) end end) end
EggSpawner.EggSpawned.Event:Connect(function(egg,zoneName,rarity,isRespawn) if not isRespawn then return end; if rarity=="Legendary" or rarity=="Mythic" then local prefix=rarity=="Mythic" and "🔥 MYTHIC EGG" or "✨ LEGENDARY EGG"; local zoneText=zoneName and (" in "..zoneName) or ""; for _,player in ipairs(Players:GetPlayers()) do Notice:FireClient(player,prefix.." HAS SPAWNED"..zoneText.."! Find it before someone else does!") end end end)
Admin.Subscribe(function(kind,value) if kind=="announce" then for _,p in ipairs(Players:GetPlayers()) do Notice:FireClient(p,"📢 ADMIN: "..tostring(value)) end elseif kind=="giveCoins" then syncAll(); for _,p in ipairs(Players:GetPlayers()) do Notice:FireClient(p,"🎁 Global giveaway: +"..tostring(value).." coins!") end elseif kind=="givePet" then syncAll(); for _,p in ipairs(Players:GetPlayers()) do Notice:FireClient(p,"🥚 Global pet giveaway: "..tostring(value).."!") end end end)
EggSpawner.Initialize()
Players.PlayerAdded:Connect(function(p) Data.Load(p); leader(p); local d=Data.Get(p); p:SetAttribute("Armor",d and d.Armor or "Cloth"); p:SetAttribute("IsAdmin",Admin.IsAdmin(p)); p:SetAttribute("NewPlayerProtection",true); p:SetAttribute("EggStagger",0); p:SetAttribute("CarryingEgg",false); if Admin.IsAdmin(p) then AdminNotice:FireClient(p,"OPEN Admin access verified for "..p.Name) end; task.delay(Config.NewPlayerProtectionSeconds,function() if p.Parent then p:SetAttribute("NewPlayerProtection",false); Notice:FireClient(p,"Starter protection expired. Armor now protects you in egg fights!") end end); task.delay(1,sync,p) end)
Players.PlayerRemoving:Connect(function(p) Data.Release(p) end)
RequestState.OnServerEvent:Connect(function(p) sync(p) end)
Mine.OnServerEvent:Connect(function(p,t) if Mining.Mine(p,t) then sync(p) end end)
Sell.OnServerEvent:Connect(function(p) local d=Data.Get(p); local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart"); if not d or not r or not sell or (r.Position-sell.Position).Magnitude>18 or d.BackpackAmount<=0 then return end; d.Coins+=d.BackpackAmount*Config.SellMultiplier; d.BackpackAmount=0; Data.MarkDirty(p); sync(p); Notice:FireClient(p,"Sold! +coins") end)
Upgrade.OnServerEvent:Connect(function(p) local ok,res=Upgrades.Upgrade(p); if ok then sync(p); Notice:FireClient(p,"Upgraded to "..res.." Pickaxe!") else Notice:FireClient(p,res) end end)
Armor.OnServerEvent:Connect(function(p) local ok,res=Combat.EquipArmor(p); if ok then p:SetAttribute("Armor",res); sync(p); Notice:FireClient(p,"Armor upgraded to "..res.."!") else Notice:FireClient(p,res) end end)
HitPlayer.OnServerEvent:Connect(function(p,target) local ok,res=Combat.HitPlayer(p,target); if ok then sync(p); if string.sub(res,1,7)=="STOLEN " then Notice:FireClient(p,"🥚 "..res.."! Run home and hatch it!"); Notice:FireClient(target,"⚠️ YOUR EGG WAS STOLEN! Find another egg!") else Notice:FireClient(p,res) end elseif res and res~="" then Notice:FireClient(p,res) end end)
TakeEgg.OnServerEvent:Connect(function(p,e) local ok,res=Eggs.Take(p,e); if ok then p:SetAttribute("CarryingEgg",true); sync(p); Notice:FireClient(p,"Egg secured! Bring it to the purple Hatch Pad.") else Notice:FireClient(p,res) end end)
Hatch.OnServerEvent:Connect(function(p) local ok,res=Eggs.HatchAtBase(p,hatchPad); if ok then p:SetAttribute("CarryingEgg",false); sync(p); Notice:FireClient(p,"Hatched "..res.Name.." ["..res.Rarity.."]! Pet bonus activated.",res) else Notice:FireClient(p,res) end end)
AdminAction.OnServerEvent:Connect(function(p,kind,payload) if not Admin.IsAdmin(p) then return end; payload=type(payload)=="table" and payload or {}; if kind=="announce" then local text=tostring(payload.text or ""):sub(1,180); if text=="" then AdminNotice:FireClient(p,"Enter an announcement first."); return end; local ok,err=Admin.PublishGlobal("announce",{text=text}); AdminNotice:FireClient(p,ok and "Broadcast sent to every server." or ("Broadcast failed: "..err)) elseif kind=="giveCoins" then local amount=math.floor(tonumber(payload.amount) or 0); if amount<=0 or amount>1000000000 then AdminNotice:FireClient(p,"Coins must be between 1 and 1,000,000,000."); return end; local ok,err=Admin.PublishGlobal("giveCoins",{amount=amount}); AdminNotice:FireClient(p,ok and ("Giveaway sent: +"..amount.." coins to every online player in every server.") or ("Giveaway failed: "..err)) elseif kind=="givePet" then local name=tostring(payload.petName or ""):sub(1,40); local rarity=tostring(payload.rarity or "Common"):sub(1,20); local mult=math.clamp(tonumber(payload.multiplier) or 1,1,1000); if name=="" then AdminNotice:FireClient(p,"Enter a pet name."); return end; local ok,err=Admin.PublishGlobal("givePet",{petName=name,rarity=rarity,multiplier=mult}); AdminNotice:FireClient(p,ok and ("Pet giveaway sent to every online player in every server: "..name) or ("Pet giveaway failed: "..err)) elseif kind=="kick" then local ok=Admin.Kick(p,tostring(payload.target or ""),tostring(payload.reason or "")); AdminNotice:FireClient(p,ok and "Player kicked." or "Player not found in this server.") elseif kind=="refresh" then sync(p); AdminNotice:FireClient(p,"Admin state refreshed.") end end)
task.spawn(function() while true do task.wait(Config.AutosaveSeconds); for _,p in ipairs(Players:GetPlayers()) do if Data.IsDirty(p) then Data.Save(p) end end end end)
game:BindToClose(function() for _,p in ipairs(Players:GetPlayers()) do Data.Save(p) end; task.wait(2) end)
